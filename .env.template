DB_NAME=worktimer.db
DEBUG_MODE=false

# Network exposure. Unset = reachable only from this machine (the safe default).
# HOST=0.0.0.0 makes WorkTimer reachable from your whole network. It has no
# login, so anyone who can reach it can read your data and tracker credentials.
# Applies to both `python main.py` and `docker compose`.
# HOST=0.0.0.0

# Postgres (v6, in development). The app runs on SQLite unless DATABASE_URL is
# set; `docker compose --profile postgres up -d --build` starts a second
# instance on Postgres (port 8090). The defaults suit a local development
# database bound to this machine; set your own passwords for anything
# reachable by others.
# POSTGRES_PASSWORD=worktimer-dev
# PG_PORT=5432
# PG_APP_PORT=8090
# WORKTIMER_APP_PASSWORD=worktimer-app-dev
# WORKTIMER_READONLY_PASSWORD=worktimer-readonly-dev
# Whole-database backups of the Postgres instance (./backups-pg): how often, in
# seconds, and how many to keep.
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_KEEP=14

# Sign-in (v6; docs/hosted.md). Unset = one
# user, no login. cloudflare-access = hosted behind a Cloudflare Access
# application: every page needs its signed token, each person signs in as their
# own user. Needs Postgres. Team domain and audience tag are on the Access
# application's overview page.
# WORKTIMER_AUTH=cloudflare-access
# CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# CF_ACCESS_AUD=<the application's audience tag>
# Whose first sign-in takes over the single-user data (docs/hosted.md).
# WORKTIMER_OWNER_EMAIL=<your email>
# The Cloudflare tunnel's token: set, and scripts/staging.sh up starts cloudflared.
# CLOUDFLARE_TUNNEL_TOKEN=<the tunnel's token>
# How many tracker syncs (all users together) may run at once.
# TRACKER_SYNC_CONCURRENCY=2
