DB_NAME=worktimer.db
DEBUG_MODE=false

# Network exposure. Unset = reachable only from this machine (the safe default).
# HOST=0.0.0.0 makes WorkTimer reachable from your whole network. It has no
# login, so anyone who can reach it can read your data and tracker credentials.
# Applies to both `python main.py` and `docker compose`.
# HOST=0.0.0.0

# Postgres (v6, in development — the app doesn't use it yet). The defaults suit
# a local development database bound to this machine; set your own password
# for anything reachable by others.
# POSTGRES_PASSWORD=worktimer-dev
# PG_PORT=5432
